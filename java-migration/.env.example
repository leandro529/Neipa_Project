# Copiar este archivo como .env (en esta misma carpeta) y completar los valores.
# El .env NO se versiona (esta en .gitignore). probar-neipa.ps1 crea uno con
# valores aleatorios si no existe.
#
# Contrasena del usuario root de MySQL (la usa tambien el backend).
MYSQL_ROOT_PASSWORD=
# Secreto con el que se cifran las contrasenas de las conexiones directas a
# bases de CM (si cambia, hay que volver a cargar esas contrasenas).
NEIPA_CM_CLAVE_CONEXIONES=
